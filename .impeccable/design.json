  "narrative": {
    "northStar": "Campus Radio",
    "overview": "The user selected warm coral, blue, and a softer feel for every page. The system combines rounded Manrope lettering, pale colored surfaces, and familiar app controls. Personality comes from friendly language and activity colors while practical plan details remain easy to scan.",
    "keyCharacteristics": [
      "Warm light surfaces with dark, legible text.",
      "Coral primary actions and sky blue welcome areas.",
      "Consistent activity colors from discovery to plan details.",
      "Spacious desktop work areas and comfortable mobile controls."
    ],
    "rules": [
      {
        "name": "The Activity Continuity Rule",
        "body": "Use TYPE_CONFIG in src/theme.js for activity identity across cards and details. Party is peach, Trip green, Outing lavender, Food Run yellow, Sports blue, and Study Sesh pink. Pair every color with an activity name.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use the bundled Manrope family throughout, including controls. Allow long names and titles to wrap inside their containers.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do pair activity colors with readable labels.",
      "Do preserve warm coral and sky blue across new screens.",
      "Do provide visible focus, useful empty states, and descriptive field labels.",
      "Do check long names, narrow screens, and scrolling dialog content."
    ],
    "donts": [
      "Don't use color alone to communicate selection or availability.",
      "Don't replace the locally hosted font with a system display face.",
      "Don't add ornamental gradients or glows to the flat, soft surface language.",
      "Don't turn the radio identity into unfamiliar controls or navigation."
    ]
  }
